[Unit]
Description=Reachy Mini realtime shell (audio owners, attention, tools)
Documentation=file://%h/dev/robot/docs/epic-realtime-rebuild.md
After=reachy-mini-daemon.service reachy-s2s.service
BindsTo=reachy-mini-daemon.service

[Service]
WorkingDirectory=%h/dev/robot
EnvironmentFile=-%h/dev/robot/.env
# Deployment environment: envs/<name>.yaml (docs/environments.md). Deliberately
# not pinned here: shell/config.py already defaults to `home`, so an
# Environment=REACHY_ENV=home line was only a second source for the room, while the
# runbook edit is a .env line. Measured on this box 2026-10-12 with a throwaway user
# unit: EnvironmentFile= beats Environment= (the file is applied after), so the pin
# would have lost anyway - and had it won, `echo REACHY_ENV=hackday >> .env` would
# have booted the home persona with the family memories in a public room, silently.
# See deploy/README.md, "Changing rooms".
ExecStart=%h/dev/robot/.venv/bin/python -m shell
Restart=on-failure
RestartSec=3
# Thread discipline per ADR 0006: this process owns audio and attention
# only; model compute belongs to llama-server and reachy-s2s.

[Install]
WantedBy=default.target
