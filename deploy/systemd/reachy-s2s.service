[Unit]
Description=Reachy Mini realtime voice pipeline (pinned huggingface/speech-to-speech)
Documentation=file://%h/dev/robot/docs/adr/0001-upstream-realtime-service.md
After=network-online.target llama-server.service reachy-llm-proxy.service
Wants=llama-server.service reachy-llm-proxy.service

[Service]
WorkingDirectory=%h/dev/robot
EnvironmentFile=-%h/dev/robot/.env
# The active persona's voice (personas/<name>.yaml rendered by scripts/apply_env.py).
# Listed AFTER .env deliberately: measured on this box 2026-10-12 with a throwaway user
# unit, systemd applies EnvironmentFile= lines in listed order with the LAST one winning
# per key, and every EnvironmentFile= beats Environment=. So the persona outranks a stray
# S2S_QWEN3_* line in .env instead of losing to it, and a key only .env sets still
# survives (persona.env writes every voice key it has an opinion about, empty included,
# which is how switching to kokoro clears the Obama talker GGUF). A voice change only
# becomes audible when this unit restarts: the flags are read once at startup
# (measured 20-46 s). It never sets REACHY_INSTRUCTIONS - see deploy/README.md.
EnvironmentFile=-%h/dev/robot/deploy/generated/persona.env
Environment=HF_HUB_OFFLINE=1
ExecStart=%h/dev/robot/scripts/run_s2s.sh
Restart=on-failure
RestartSec=3
# Fully local; give the service no reason to reach the internet beyond model
# downloads that already happened at install time. First run on a fresh box:
# HF_HUB_OFFLINE=0 scripts/run_s2s.sh once to fetch Parakeet/Kokoro/smart-turn.

[Install]
WantedBy=default.target
