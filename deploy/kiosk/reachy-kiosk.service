[Unit]
# SYSTEM unit, not a user unit. This is the shape systemd documents for "a service that
# owns a console session" (a hand-written display manager), and the reason it is written
# this way is measured, not theoretical:
#
#   * As a systemd USER unit, the same ExecStart crash-looped on
#     /usr/lib/Xorg.wrap: "Only console users are allowed to run the X server". A user
#     service is never the owner of the foreground VT, so rootless X refuses it. No env
#     in the unit fixes that - it is structural (measured 2026-10-13, see README).
#   * PAMName=login is what fixes it. /etc/pam.d/login -> system-local-login ->
#     system-login, whose line 20 is `-session optional pam_systemd.so`, so the service
#     gets a real logind session on seat0 - which is also the only thing that puts an ACL
#     on /dev/dri/card1 (measured today: root:video 0660, other::---, and david holds no
#     seat from an ssh session, so X could not have opened the GPU either way).
#   * X, not Wayland: cage has a documented "displays nothing" failure on a GTX 1070 under
#     Arch (cage-kiosk #441) and this box is a 1070 on driver 580.142 with no keyboard
#     attached to debug it. nvidia_drv.so and modesetting_drv.so are both installed.
#
# There is NO keyboard on this machine. Everything about this unit therefore has to be
# observable over ssh: StandardOutput=journal, a fixed VT, and `systemctl status` as the
# only diagnosis channel.
Description=Reachy Mini attendee kiosk on VT1 (issue #37)
Documentation=file://%h/dev/robot/deploy/kiosk/README.md
After=graphical.target
After=systemd-user-sessions.service
After=user@1000.service
Wants=systemd-user-sessions.service
Wants=user@1000.service
# This unit takes tty1 away from the login prompt; the installer masks getty@tty1 so the
# two never fight for the VT. The ordering makes the stop/start order deterministic.
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
Type=simple
User=david
WorkingDirectory=~
PAMName=login
Environment=XDG_SESSION_TYPE=x11
# XDG_SEAT / XDG_VTNR / XDG_RUNTIME_DIR deliberately NOT set: the reference recipe for rootless X
# under systemd sets only XDG_SESSION_TYPE and lets pam_systemd do the seat binding itself. Ours
# also pre-set these three, and no logind session ever appeared on tty1 (loginctl showed only the
# SSH session) even though pam_unix reported "session opened for user david". One of the two is
# wrong; matching the recipe that demonstrably works is cheaper than finding out which.
# If X now fails with "Only console users are allowed", THIS is the next variable to revisit.
# pam_systemd supplies this too; stating it keeps chromium and xinit honest if it does not.
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
UnsetEnvironment=TERM
UtmpIdentifier=tty1
UtmpMode=user
TTYReset=yes
# Deliberately NOT TTYVHangup=yes / TTYVTDisallocate=yes, which kiosk guides copy freely.
# Both take the console away from you on the way out, and on the PROPRIETARY nvidia driver
# without nvidia_drm.modeset=1 on the kernel command line (measured: nvidia_drm is loaded,
# /proc/cmdline carries no modeset parameter, and the param itself is unreadable to us)
# that is the classic way to end up with a permanently black text console - unrecoverable
# at this machine, because the booth has NO KEYBOARD and the only seatbelt is SSH.
# The kernel param is the real fix and it needs a reboot, so tonight we keep the console.
TTYVHangup=no
TTYVTDisallocate=no
Nice=10

# The `+` prefix runs this one line as root: chvt needs to be the foreground-VT owner or
# root, and User=david above would otherwise apply to it and fail.
ExecStartPre=+/usr/bin/chvt 1
# reachy-dashboard.service is a USER unit (~/.config/systemd/user), and a system unit
# cannot order against one - scopes do not mix. The gate is instead the bounded 30 s curl
# wait inside kiosk.xinitrc, which is why that wait exists. If the dashboard is ever moved
# to system scope, add Wants=/After= for it here as well.
#
# --disable-gpu lives in kiosk.xinitrc, not here: the GTX 1070 is at ~7.8/8 GB with
# llama.cpp and Qwen3-TTS (docs/pins.yaml), and a compositor asking for GL is what takes
# the demo down. -keeptty keeps X attached to tty1 so its death is in this unit's journal.
# %h is NOT allowed here, and this is the bug that cost the whole evening: in a SYSTEM unit %h
# expands to the home of whoever runs the system manager - /root - and does NOT follow User=david.
# Measured from `systemctl show -p ExecStart`: startx was handed /root/dev/robot/.../kiosk.xinitrc,
# which does not exist, so X never spawned (no ~/.local/share/xorg/, death in <1 s, and
# `systemd-analyze verify` said nothing because it checks syntax, not paths). scripts/
# install_kiosk.sh rewrites this line against $HOME at install time; the value below is what
# /home/david needs, so a bare `cp` also works. -verbose 3 -logfile /dev/null routes X's own
# output into the journal, because -keeptty otherwise sends it to a console nobody can read.
ExecStart=/usr/bin/startx /home/david/dev/robot/deploy/kiosk/kiosk.xinitrc -- :0 vt1 -keeptty -verbose 3 -logfile /dev/null
# The kiosk is decoration. The previous version of this file carried
# `StopPropagationOfFailedJobsFromThisUnitFile=`, which is not a systemd directive at all (it
# is in no man page, and `systemd-analyze verify` calls it "Unknown key ... ignoring") - a
# no-op that read like a safety guarantee, so it is gone rather than copied forward.
# Isolation from the voice stack is real but comes from being its own unit: nothing here
# Requires= or PartOf=s anything in the demo stack.
#
# Restart=always, not on-failure: killing chromium (or any clean exit of the X session)
# makes startx exit 0, and on-failure would then leave a black panel that nothing recovers.
# There is no keyboard on this box, so "it stopped cleanly" must not mean "it stays stopped".
# A browser crash is a 3 s flicker; a stray pkill is a 3 s flicker.
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
