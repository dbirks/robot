# ---- new stack (shell/ + pinned s2s service; see deploy/README.md) ----

# Realtime service (pinned huggingface/speech-to-speech, ADR 0001)
S2S_URL=ws://127.0.0.1:8765/v1/realtime
REACHY_PROFILE=quiet            # quiet | home_tv | event (shell/attention/profiles.py)
# REACHY_INSTRUCTIONS=...       # override Reachy's persona prompt
# REACHY_MIC=                   # sounddevice device name/index (default: system)
# REACHY_SPEAKER=
KWS_MODEL_DIR=models/kws        # pinned model, see issue #23

# llama.cpp is reached by the s2s service over the OpenAI responses-api:
LLM_API_KEY=not-needed          # dummy value REQUIRED even fully local
OPENAI_BASE_URL=http://localhost:8080/v1

# ---- legacy loop (app/, deleted at cutover, issue #22) ----

LLM_BASE_URL=http://localhost:8080/v1
LLM_MODEL=qwen3.5-4b
LLM_MAX_TOKENS=256
PIPER_VOICE_PATH=models/piper/en_GB-northern_english_male-medium.onnx
VAD_THRESHOLD=0.5
VAD_MIN_SILENCE_MS=800
REACHY_HOST=localhost
MODELS_DIR=models
LOGS_DIR=logs
